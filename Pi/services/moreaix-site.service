[Unit]
Description=moreaix.com Static Homepage Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
# 主页产物（index.html + logo*.svg）放在 /home/user/site，serve.py 只读地发出去。
WorkingDirectory=/home/user/site
# 8081 只绑默认的 127.0.0.1：公网入口只有 Cloudflare Tunnel，本机不开任何公网端口。
# --prefix= 表示根域主页挂在 / 上。
# 两个 --alias 让它一台顶三台：
#   /kindle → 看板图。Tunnel 的 ingress 是顺序匹配、命中即停，根域那条不带 path 的
#             兜底规则会吃掉所有路径，单开一条 /kindle 的 Public Hostname 永远轮不到。
#   /rss    → feed 目录。原先由独立的 rss-serve（8080）承担，但那就是同一个 serve.py
#             换了参数；合并之后 Tunnel 只需要一条根域规则，顺序/正则那些坑一起消失。
ExecStart=/usr/bin/python3 /home/user/pi-pipeline/serve.py --root /home/user/site --port 8081 --prefix= --alias /kindle=/home/user/kindle --alias /rss=/home/user/rss-hub/docs
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# Cloudflare Web Analytics 的站点 token 放这里，不进仓库：
#   CF_BEACON_TOKEN=<控制台 Manage site 里给的 token>
# 前面的 - 表示文件不存在也照常启动（没配 token = 不注入 beacon，服务行为不变）。
# 手写后 `sudo systemctl daemon-reload && sudo systemctl restart moreaix-site` 即生效。
# 注意：Environment= 写在 .service 里才有效，写进 .timer 是死键。
EnvironmentFile=-/home/user/site/analytics.env

[Install]
WantedBy=multi-user.target
