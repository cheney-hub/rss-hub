[Unit]
Description=RSS build on Pi (one round, local state)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=user
WorkingDirectory=/home/user/rss-hub
# 让脚本内部的时间（日志、pubDate 里的显示时间）与系统时区一致。
# 注意它**不影响** rss-build.timer 的 OnCalendar：日历定时按系统时区解释，
# Environment 只作用于本进程。所以 Pi 的 timedatectl 必须设成 Asia/Shanghai
# （见 Pi/README.md「时区」一节），否则 07..23 的日夜节拍会整体偏移。
Environment=TZ=Asia/Shanghai

Environment=FEEDS_FILE=/home/user/rss-hub/feeds.txt
# 每轮构建前从仓库拉一次清单：改完 feeds.txt 推上去，最多等一个节拍（白天 5 分钟、
# 夜间 1 小时）就在 Pi 上生效，不用再手工 scp。拉不到/内容不像清单就沿用本地那份，
# 构建照常跑 —— 同步失败绝不能让整份 feed 停摆。
Environment=FEEDS_SYNC_URL=https://raw.githubusercontent.com/cheney-hub/rss-hub/main/feeds.txt
# 产物放内存盘：/dev/shm 是 tmpfs，白天每 5 分钟一轮的 400KB feed.xml 不写 SD 卡。
# 目录由 ExecStartPre 幂等创建 —— 开机时 /dev/shm 是空的，哪个单元先跑谁建都行。
Environment=OUT_FILE=/dev/shm/rss-hub/feed.xml
Environment=FEED_URL=https://moreaix.com/rss/feed.xml
# 抓取只负责完整版 feed.xml（池子）。设备版与显示游标交给 rss-rotate.service，
# 所以这里把它俩指到内存盘里另两个名字：抓取白天每 5 分钟一轮、夜间每小时一轮，
# 不该顺手替屏幕决定「现在播哪一条」（两者节奏不同，捆一起屏幕就会僵住）。
Environment=SCREEN_OUT=/dev/shm/rss-hub/feed-wrap-build.xml
Environment=ROTATE_STATE=/dev/shm/rss-hub/rotate-build.json
# 线上状态的兜底地址：本地 rotate.json 丢了就从这儿取回游标。
# 端口跟着 moreaix-site 走 —— 8080 那台静态服务已合并进 8081，别再指回去。
Environment=ROTATE_STATE_URL=http://127.0.0.1:8081/rss/rotate.json
Environment=PER_SOURCE=5
Environment=ITEM_LIMIT=120
# 必须与 rss-rotate.service 的同名项相等：池子大小不同，build 选条与屏幕选条
# 看到的就不是同一批条目，轮播会选出「build 眼里早已不在池里」的内容。
Environment=ROTATE_POOL_MAX=120
Environment=SOURCE_TZ_OFFSET=8
Environment=CONCURRENCY=10
Environment=FETCH_TIMEOUT=15

# 默认 TimeoutStartSec=90s 会把这一轮直接打断：49 个源 / 并发 10 = 5 批，
# 每源最坏 15s 超时 + 1s 退避 + 再 15s 重试 = 31s，5 批就是 ~155s。
# 被 SIGTERM 时 feed.xml 不会更新（_write 是最后一步原子替换），
# 表现是「feed 停更但没有任何报错」，只能靠事后翻 journal 才发现。
TimeoutStartSec=900
TimeoutStopSec=30

# flock：上一轮还没跑完就跳过本 tick，绝不并发两轮。锁文件也放内存盘，
# 免得每 5 分钟在 SD 卡上碰一次 /tmp。
ExecStartPre=/usr/bin/install -d -m 700 /dev/shm/rss-hub /dev/shm/rss-hub/kindle
ExecStart=/bin/bash -c 'exec 9>/dev/shm/rss-hub/rss-build.lock; flock -n 9 || exit 0; exec /usr/bin/python3 /home/user/rss-hub/build_feed.py'

# 每次构建后把当前 feed 并入「当日滚动池」ai-accum.json（reader「全天缓存」视图的数据源）：
# 随 rss-build 全天节拍刷新（白天每 5 分钟、夜间每小时），按归一标题去重 + 原子写 tmpfs，
# 不落 SD。AI 摘要进程不再负责维护池子，只从池子读。失败以 0 退出，绝不影响本次构建。
ExecStartPost=/bin/bash -c 'exec /usr/bin/python3 /home/user/pi-pipeline/accum_update.py || true'
