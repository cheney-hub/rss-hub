[Unit]
Description=Daily journal snapshot at 00:05

[Timer]
# 一天一次，导出过去 24 小时；快照只留最近 3 份，由脚本清理。
# 刻意不写 Persistent=true：那会在 /var/lib/systemd/timers/ 落一个 stamp 文件，
# 等于为了存快照又重新往 SD 卡写东西；而且 volatile 日志重启即空，
# 补跑也导不出有意义的内容。错过这一拍就等下一天。
OnCalendar=*-*-* 00:05:00
AccuracySec=1min
Unit=journal-snapshot.service

[Install]
WantedBy=timers.target
