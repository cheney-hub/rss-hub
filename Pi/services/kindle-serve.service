[Unit]
Description=Kindle board static server (serve.py on 8082, routed by tunnel as board.moreaix.com)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/kindle
# 首次开机的顺序不可控：kindle-serve 可能先于第一次渲染起来，那时 /home/user/kindle
# 还不存在，serve.py 会直接 exit。没有这一行，单元会一直 failed，
# 要等人手动 restart 才能恢复（Restart=always 救不了「参数导致必然失败」）。
ExecStartPre=/bin/mkdir -p /home/user/kindle
# 绑 0.0.0.0 而不是只绑回环：三个来源都要够得到它 —— 局域网里的 Kindle 板子、
# 本机上的 cloudflared（隧道把公网请求转发到 localhost:8082）、以及排障时的 curl。
# 8080/8081 仍只监听 127.0.0.1，和这台互不影响。
# --prefix= 表示不要 /rss 那层前缀：板子上的 board.sh 直接取 /kindle.png，
# 空路径会被 serve.py 兜成 index.html（也就是 kindle_page.py 产出的网页看板）。
ExecStart=/usr/bin/python3 /home/user/pi-pipeline/serve.py --root /home/user/kindle --port 8082 --bind 0.0.0.0 --prefix=
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
