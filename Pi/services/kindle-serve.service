[Unit]
Description=Kindle board static server on 8082 (RETIRED 2026-11-01; public path is moreaix.com/kindle via moreaix-site)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/kindle
# 首次开机的顺序不可控：kindle-serve 可能先于第一次渲染起来，那时 /home/user/kindle
# 还不存在，serve.py 会直接 exit。没有这一行，单元会一直 failed，
# 要等人手动 restart 才能恢复（Restart=always 救不了「参数导致必然失败」）。
ExecStartPre=/bin/mkdir -p /home/user/kindle
# 【已停用】单元留着是为了方便恢复，平时不要 enable 它：
#   - 公网那条已由 moreaix-site（8081）的 --alias /kindle 承担，Tunnel 不会再来 8082
#   - 它原本唯一的用途是局域网里 Kindle 就近取图，而 Pi 把 wlan0 入站全 DROP 了，
#     实测 24 小时零外部访问；绑 0.0.0.0 反而是全机唯一一个对外开放的端口
#   - 恢复办法：sudo systemctl enable --now kindle-serve（比如局域网那堵墙修好之后）
# --prefix=/kindle：一旦恢复，公网口径是 https://moreaix.com/kindle/rss-pw2.png，
# 这层前缀由 serve.py 剥掉；局域网直接取 /rss-pw2.png（不带前缀）也照样通。
ExecStart=/usr/bin/python3 /home/user/pi-pipeline/serve.py --root /home/user/kindle --port 8082 --bind 0.0.0.0 --prefix=/kindle
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
