[Unit]
Description=Kindle board PNG server (LAN only, not routed by Cloudflare Tunnel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/kindle
# 只有这一台绑 0.0.0.0 —— Kindle 在家庭局域网里来取图，不经过 Cloudflare。
# 8080/8081 仍只监听 127.0.0.1 给 Tunnel 用，两套服务互不影响。
ExecStart=/usr/bin/python3 /home/user/pi-pipeline/serve.py --root /home/user/kindle --port 8082 --bind 0.0.0.0 --prefix=
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
