{
  "name": "rss-hub",
  "version": "1.1.0",
  "private": true,
  "description": "多源 RSS 头条聚合：GitHub Actions 定时抓取 feeds.txt 里的源，生成 docs/feed.xml 并由 GitHub Pages 发布",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "feed": "python3 build_feed.py",
    "feed:once": "REFRESH_SECONDS=0 python3 build_feed.py"
  },
  "engines": {
    "node": ">=18"
  }
}
