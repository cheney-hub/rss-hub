# 本地运行产物（生成物 docs/feed.xml 要入库，供 Pages 兜底；设备版 feed-wrap.xml 不入库，
# 1.7.0 起 GitHub 侧只发布完整版，设备版由树莓派 moreaix.com/rss/ 提供）
__pycache__/
*.pyc
docs/rotate.json
# 本地直接跑 build_feed.py 会写出这一份（两个正式部署都不发布它：GitHub 指到 runner.temp、
# 树莓派由 rotate_screen.py 单独写），忽略掉免得被误提交
docs/feed-wrap.xml
.DS_Store
Thumbs.db

# 临时目录：.qa-tmp 放 QA 的仿真/压测脚本，*.tmp.xml 是本地跑出来的中间产物
.qa-tmp/
*.tmp.xml

# ---- 凭证与密钥：一律不入库 ----
.env
.env.*
*.env
rss-hub.env
*.pem
*.key
*.p12
*.pfx
id_rsa*
credentials.json
secrets.json

# Kindle 打包产物（kindletool 出的 .bin 和对外分发用的 zip，都能现场重建）
kindle/dist/

# 一次性诊断产物：在 Pi 上跑 AI 重点页可靠性采样时拉取的 feed / 生成的 HTML / 诊断脚本，
# 含 340KB 的 feed 抓取文件，纯本地排查用，不入库
diag/
