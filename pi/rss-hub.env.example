# RSS 聚合器凭证模板
#
# 用法（不要把这个文件本身填完提交，复制到仓库之外再填）：
#   sudo install -d -m 700 /etc/rss-hub
#   sudo install -m 600 pi/rss-hub.env.example /etc/rss-hub/rss-hub.env
#   sudo nano /etc/rss-hub/rss-hub.env
#
# 说明：这里只放「这台机器」需要的东西，仓库里不存在任何 token 或口令。

# 必填：GitHub Personal Access Token，classic 勾 repo；或 fine-grained 勾 Contents: read and write
GITHUB_TOKEN=

# 必填：目标仓库，形如 owner/repo
GITHUB_REPO=

# 选填：分支，默认 main
GITHUB_BRANCH=main
