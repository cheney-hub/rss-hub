[Unit]
Description=RSS aggregator: fetch feeds and push feed.xml to GitHub Pages
# 等网络真正可用后再跑，避免开机瞬间推送失败
After=network-online.target
Wants=network-online.target
# 凭证文件缺失时直接跳过，避免日志里刷一堆 401
ConditionFileNotEmpty=/etc/rss-hub/rss-hub.env

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/rss-aggregator
# 凭证只从本机 600 权限的文件读取；本仓库不含任何 token / 口令
# 由 pi/install.sh 创建，格式见 pi/rss-hub.env.example
EnvironmentFile=/etc/rss-hub/rss-hub.env
ExecStart=/usr/bin/python3 /home/pi/rss-aggregator/aggregate_rss.py
# 单轮失败不特殊处理：脚本内部有重试和回退，下个 timer 周期会自动再来
