[Unit]
Description=RSS aggregator: fetch feeds and push feed.xml to GitHub Pages
# 等网络真正可用后再跑，避免开机瞬间推送失败
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/rss-aggregator
# ↓↓↓ 改成你自己的 token 和仓库 ↓↓↓
Environment=GITHUB_TOKEN=ghp_替换成你的token
Environment=GITHUB_REPO=你的用户名/rss-hub
ExecStart=/usr/bin/python3 /home/pi/rss-aggregator/aggregate_rss.py
# 单轮失败不特殊处理：脚本内部有重试和回退，下个 timer 周期会自动再来
